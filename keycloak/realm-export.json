{
  "realm": "sentineldms",
  "enabled": true,
  "displayName": "SentinelDMS",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "investigating_officer", "description": "Field officer; access limited to cases within their own department" },
      { "name": "judicial_officer", "description": "Court-side role; MFA required" },
      { "name": "forensic_expert", "description": "Forensic lab role; MFA required" },
      { "name": "admin", "description": "Full administrative access; MFA required" },
      { "name": "auditor", "description": "Read-only access across all departments; MFA required" }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    }
  ],
  "clients": [
    {
      "clientId": "sentineldms-backend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    }
  ],
