# Copy this file to .env for local dev — .env is gitignored.
# These values match the merged root docker-compose.yml exactly.

# --- App ---
PORT=3000
NODE_ENV=development

# --- Postgres (Arunkumar's schema — see ../database) ---
DATABASE_URL="postgresql://sentinel:sentinel_secret_change_in_prod@localhost:5432/sentineldms?schema=public"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_in_prod

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=sentinel_minio
MINIO_SECRET_KEY=minio_secret_change_in_prod
MINIO_BUCKET=sentineldms
MINIO_USE_SSL=false

# --- Elasticsearch (infra is up; /documents search doesn't use it yet — see documents.service.ts) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Keycloak (Dharani's realm — see ../keycloak/realm-export.json) ---
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=sentineldms
KEYCLOAK_CLIENT_ID=sentineldms-backend
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/sentineldms/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8080/realms/sentineldms

# --- Downstream services ---
AI_SERVICE_URL=http://localhost:8000
# Dharani's blockchain-api — see ../blockchain/README.md. Falls back to mock
# responses automatically if this isn't running (see integrations/*.service.ts).
BLOCKCHAIN_SERVICE_URL=http://localhost:4000

# --- Local file mirror for blockchain-api's hash verification ---
# MUST match DOCUMENT_STORAGE_PATH in blockchain/services/blockchain-api/.env
# exactly (that file's path is relative to services/blockchain-api/, this
# one is relative to backend/ — both need to resolve to the SAME folder on
# disk). Default here resolves to <repo-root>/shared-storage.
DOCUMENT_STORAGE_PATH=../shared-storage
