# Application Settings
PROJECT_NAME="SentinelDMS"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-this-with-a-super-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL) - adjust user/password if needed
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sentineldms"

# MinIO Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE=False
MINIO_BUCKET_DOCUMENTS="sentinel-documents"

# Blockchain (Dev Mode Hyperledger)
BLOCKCHAIN_PEER_URL="http://localhost:3000"

# Mail Settings for OTP
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="your-email@gmail.com"
EMAILS_FROM_NAME="SentinelDMS Security"
