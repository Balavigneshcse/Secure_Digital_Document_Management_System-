# Server
PORT=4000

# Fabric connection
FABRIC_CONNECTION_PROFILE=./config/connection-profile.json
FABRIC_WALLET_PATH=./wallet
FABRIC_IDENTITY=appUser
FABRIC_CHANNEL_NAME=sentinelchannel
FABRIC_CHAINCODE_NAME=documentanchor
# Set to "false" only when this service runs inside a Docker container
# joined to Fabric's network (see docker-compose.yml). Leave as "true"
# (default) when running the API directly on the host.
FABRIC_DISCOVERY_AS_LOCALHOST=true

# Fabric CA enrollment (used by enrollAdmin.js / registerUser.js —
# run those two scripts once before starting the API, or every call
# will fail with "Identity not found in wallet")
FABRIC_CA_ADMIN_ID=admin
FABRIC_CA_ADMIN_SECRET=adminpw
FABRIC_MSP_ID=Org1MSP
FABRIC_AFFILIATION=org1.department1

# Where document blobs actually live (used to recompute hashes for /verify).
# Point this at MinIO/S3/local disk depending on what Arunkumar's storage
# module exposes by the time you integrate.
DOCUMENT_STORAGE_PATH=./storage

# PKI / signature service
CA_CERT_PATH=./ca/ca-cert.pem
CA_KEY_PATH=./ca/ca-key.pem
CERT_STORE_PATH=./ca/issued
SIGNATURE_STORE_PATH=./ca/signatures-store.json
